# Copy to .env.local (git-ignored) and fill in real values. Never commit them.
# All of these are server-only: no NEXT_PUBLIC_ prefix, never sent to the browser.

# Canonical site origin, read at build time, for example https://domain.tld.
# Leave empty locally: canonical URLs, sitemap entries, and structured-data
# URLs are omitted while it is unset. Production sets it in the GitHub
# `production` environment (docs/architecture/deployment.md).
SITE_URL=

# Contact form. Without these three, POST /api/contact responds 500 and sends nothing.

# Resend API key with sending access.
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that receives contact form messages. Fixed here; never taken from the request.
CONTACT_TO_EMAIL=your-email@example.com

# Verified Resend sender. The visitor's address is only used as Reply-To.
CONTACT_FROM_EMAIL=Portfolio <onboarding@example.com>

# Private console (/admin). See docs/architecture/mail-console.md.

# DynamoDB table name. Production sets it from the CloudFormation stack. Leave
# empty locally to use a temporary in-memory store (development only; data is
# lost on restart). Set it, with AWS credentials and AWS_REGION in your shell,
# to use a real table.
ADMIN_TABLE_NAME=

# One-time owner setup token, at least 32 characters, for example the output
# of `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# While set and no owner exists, /admin/setup creates the owner. Empty closes it.
ADMIN_BOOTSTRAP_TOKEN=

# Gmail connection (Google OAuth). Without all three, connecting Gmail reports
# that it is not configured. Values come from the Google Cloud OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed exactly as an authorized redirect URI on that client. Locally:
# http://localhost:3000/admin/oauth/google/callback. Production derives it from
# SITE_URL in the CloudFormation template.
GOOGLE_OAUTH_REDIRECT_URI=

# KMS key for encrypting stored Gmail refresh tokens. Production sets it from
# the CloudFormation stack. Leave empty locally to use a temporary in-process
# key (development only; connections need reconnecting after a restart).
GMAIL_TOKEN_KMS_KEY_ID=
