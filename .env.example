# Copy to .env.local (git-ignored) and fill in real values. Never commit them.
# All of these are server-only: no NEXT_PUBLIC_ prefix, never sent to the browser.

# Canonical site origin, read at build time, for example https://domain.tld.
# Leave empty locally: canonical URLs, sitemap entries, and structured-data
# URLs are omitted while it is unset. Production sets it in the GitHub
# `production` environment (docs/architecture/deployment.md).
SITE_URL=

# Contact form. Without these three, POST /api/contact responds 500 and sends nothing.

# Resend API key with sending access.
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that receives contact form messages. Fixed here; never taken from the request.
CONTACT_TO_EMAIL=your-email@example.com

# Verified Resend sender. The visitor's address is only used as Reply-To.
CONTACT_FROM_EMAIL=Portfolio <onboarding@example.com>
